# Copy to .env for local runs. In GitHub Actions, set these as repository secrets.

# --- Database ---------------------------------------------------------------
# Supabase/Neon Postgres connection string (use the pooled/session URL).
# Leave empty to use a local SQLite file (dealbot.db) for development.
DATABASE_URL=

# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Public channel: @yourchannel  (or the numeric -100... id). Bot must be an admin.
TELEGRAM_CHANNEL_ID=
# Private chat (or group) where review cards are sent. Your own user id works.
TELEGRAM_REVIEW_CHAT_ID=
# Comma-separated Telegram user ids allowed to tap Approve/Reject.
# Defaults to the review chat id when that is a private chat.
TELEGRAM_REVIEWER_IDS=

# --- Affiliate identities ---------------------------------------------------
AMAZON_TAG=            # Amazon Associates India store id, e.g. yourname-21
FLIPKART_AFFID=        # Flipkart Affiliate tracking id
FLIPKART_TOKEN=        # Flipkart Affiliate API token (enables the offers collector)
# Other stores via an affiliate network. JSON map of store -> URL template with {url}.
# Copy the deep-link format from your EarnKaro / Cuelinks dashboard.
# AFFILIATE_WRAP_JSON={"myntra":"https://<network-deeplink-host>/?id=XXXX&url={url}"}
AFFILIATE_WRAP_JSON=

# --- Sources ----------------------------------------------------------------
# Comma-separated RSS feed URLs. Check each site's terms before using its feed.
RSS_FEEDS=
# Hand-picked deals file (see data/sample_deals.json for the format).
MANUAL_DEALS_FILE=

# --- Behaviour --------------------------------------------------------------
MSG_LANG=hi            # hi = Hinglish, en = English
MIN_SCORE=30
MIN_UNVERIFIED_DISCOUNT=35 # % off MRP needed for a deal with no price history yet
AUTO_APPROVE_SCORE=101 # 101 = never auto-approve (manual review for every post)
MAX_POSTS_PER_DAY=30
MAX_POSTS_PER_RUN=4
MAX_REVIEW_CARDS_PER_RUN=8
REVIEW_TTL_HOURS=8
QUIET_START_HOUR=0     # IST, no posting from 00:00 ...
QUIET_END_HOUR=7       # ... until 07:00
DRY_RUN=0              # 1 = print Telegram calls instead of sending
